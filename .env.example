# SelfReg AI - Environment variables (recommended structure)
# Copy to .env.local for local development

DEFAULT_AI_PROVIDER=mock
APP_BASE_URL=http://localhost:3000

# Security
ALLOW_EPHEMERAL_USER_KEYS=true
ALLOW_STORED_USER_KEYS=false
APP_ENCRYPTION_KEY=

# GitHub Models (recommended free option)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-oss-120b

# GigaChat (showcase only)
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
